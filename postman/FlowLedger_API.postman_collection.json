{
  "info": {
    "_postman_id": "8f8b3c9a-1122-4433-8899-flowledger001",
    "name": "FlowLedger Mini ERP + CRM Operations API",
    "description": "Production REST API Collection for FlowLedger Operations Engine",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api", "type": "string" },
    { "key": "authToken", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@flowledger.io\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login (Sales Rep)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sales@flowledger.io\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        },
        {
          "name": "List System Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/users", "host": ["{{baseUrl}}"], "path": ["auth", "users"] }
          }
        }
      ]
    },
    {
      "name": "Dashboard & Analytics",
      "item": [
        {
          "name": "Get Operations KPIs & Charts",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/dashboard/stats", "host": ["{{baseUrl}}"], "path": ["dashboard", "stats"] }
          }
        },
        {
          "name": "Get Smart Action Alerts",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/dashboard/alerts", "host": ["{{baseUrl}}"], "path": ["dashboard", "alerts"] }
          }
        }
      ]
    },
    {
      "name": "CRM Customers",
      "item": [
        {
          "name": "List Customers (with search & filters)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/customers?customerType=WHOLESALE&status=ACTIVE&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["customers"],
              "query": [
                { "key": "customerType", "value": "WHOLESALE" },
                { "key": "status", "value": "ACTIVE" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Customer 360 Deep View",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/customers/:id/360", "host": ["{{baseUrl}}"], "path": ["customers", ":id", "360"] }
          }
        },
        {
          "name": "Create Customer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rajesh Agrawal\",\n  \"businessName\": \"Apex Engineering Allied Corp\",\n  \"mobile\": \"+91 98200 88991\",\n  \"email\": \"contact@apexallied.in\",\n  \"gstNumber\": \"27AABCA1234F1Z5\",\n  \"customerType\": \"WHOLESALE\",\n  \"address\": \"MIDC Industrial Phase 2, Turbhe\",\n  \"city\": \"Navi Mumbai\",\n  \"state\": \"Maharashtra\",\n  \"pincode\": \"400705\",\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/customers", "host": ["{{baseUrl}}"], "path": ["customers"] }
          }
        },
        {
          "name": "Add Customer Note",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Discussed 60-day credit term extension based on quarterly ₹10L volume guarantee.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/customers/:id/notes", "host": ["{{baseUrl}}"], "path": ["customers", ":id", "notes"] }
          }
        }
      ]
    },
    {
      "name": "Smart Follow-ups",
      "item": [
        {
          "name": "List Follow-ups (Overdue / Today / Upcoming)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/followups?timeframe=today&priority=HIGH",
              "host": ["{{baseUrl}}"],
              "path": ["followups"],
              "query": [
                { "key": "timeframe", "value": "today" },
                { "key": "priority", "value": "HIGH" }
              ]
            }
          }
        },
        {
          "name": "Update Follow-up Status (Complete / Reschedule)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"COMPLETED\",\n  \"notes\": \"Signed contract copy collected.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/followups/:id/status", "host": ["{{baseUrl}}"], "path": ["followups", ":id", "status"] }
          }
        }
      ]
    },
    {
      "name": "Products & Inventory",
